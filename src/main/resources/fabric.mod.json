{
  "schemaVersion": 1,
  "id": "findmyitems",
  "version": "${version}",
  "name": "Find My Items",
  "description": "Indexes opened containers, searches items and crafting materials, and safely gathers or retrieves them from one screen. Crafting-table recipes only; single-player worlds only.",
  "authors": ["SonicKarnati"],
  "icon": "assets/findmyitems/icon.png",
  "license": "All-Rights-Reserved",
  "contact": {
    "homepage": "https://github.com/simply-sunny/find-my-items",
    "sources": "https://github.com/simply-sunny/find-my-items",
    "issues": "https://github.com/simply-sunny/find-my-items/issues"
  },
  "environment": "client",
  "accessWidener": "findmyitems.accesswidener",
  "entrypoints": {
    "client": [
      "dev.smpb.findmyitems.FindMyItemsClient"
    ],
    "modmenu": [
      "dev.smpb.findmyitems.config.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*",
    "modmenu": ">=20.0.0",
    "cloth-config": ">=26.0.0"
  },
  "recommends": {
    "sodium": ">=0.9.0",
    "shulkerboxtooltip": "*"
  }
}
